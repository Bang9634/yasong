[Unit]
Description=Yasong Museum Spring Boot Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yasong-art-gallery
Group=yasong-art-gallery
WorkingDirectory=/home/yasong-art-gallery
Environment=FILE_UPLOAD_DIR=/home/yasong-art-gallery/uploads
EnvironmentFile=/home/yasong-art-gallery/.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/yasong-art-gallery/logs/heapdump.hprof -jar /home/yasong-art-gallery/yasong-art-gallery.jar --spring.profiles.active=prod --server.address=127.0.0.1
SuccessExitStatus=143
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yasong-art-gallery
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
