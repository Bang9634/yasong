[Unit]
Description=Yasongmuseum Spring Boot Application
Documentation=https://github.com/bang9634/yasongmuseum
After=syslog.target network.target mysql.service

[Service]
Type=simple
User=yasongmuseum
Group=yasongmuseum

# 작업 디렉토리
WorkingDirectory=/home/yasongmuseum

# 환경 변수 파일 로드 (보안을 위해 필수!)
EnvironmentFile=/home/yasongmuseum/.env

# 실행 명령
ExecStart=/usr/bin/java \
  -Xms512m \
  -Xmx1024m \
  -jar /home/yasongmuseum/yasongmuseum-0.0.1-SNAPSHOT.jar \
  --spring.profiles.active=${SPRING_PROFILES_ACTIVE}

# 정상 종료 시그널
SuccessExitStatus=143
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 로그 설정 (journalctl로 관리)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yasongmuseum

# 자동 재시작 설정
Restart=always
RestartSec=10

# 보안 설정
NoNewPrivileges=true
PrivateTmp=true

# 리소스 제한
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
