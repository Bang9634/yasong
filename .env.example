# 환경 변수 설정 예시 파일
# 실제 사용 시 .env 파일로 복사하고 값을 채워주세요
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!

# JWT Secret (64바이트 이상 권장)
# 생성 방법: openssl rand -base64 64
JWT_SECRET=

# JWT 만료 시간 (밀리초, 기본 24시간)
JWT_EXPIRATION=86400000

# 데이터베이스 설정
DB_URL=jdbc:mysql://localhost:3306/yasongmuseum?useSSL=true&serverTimezone=Asia/Seoul
DB_USERNAME=yasongmuseum_user
DB_PASSWORD=

# 서버 포트
SERVER_PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
