# MySQL 로컬 개발 환경 설정
spring.datasource.url=jdbc:mysql://localhost:3306/yasongmuseum?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=your_password_here
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Base64 JWT key. Generate with: openssl rand -base64 64 | tr -d '\n'
# Set JWT_SECRET in your shell, or replace this expression with a private generated key.
jwt.secret=${JWT_SECRET}
