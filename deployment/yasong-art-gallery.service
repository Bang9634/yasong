[Unit]
Description=Yasong Art Gallery Spring Boot Application
Documentation=https://github.com/bang9634/yasong-art-gallery
After=syslog.target network.target mysql.service

[Service]
Type=simple
User=yasong-art-gallery
Group=yasong-art-gallery

# 작업 디렉토리
WorkingDirectory=/home/yasong-art-gallery

# 환경 변수 파일 로드 (보안을 위해 필수!)
EnvironmentFile=/home/yasong-art-gallery/.env

# 실행 명령 (1GB 서버 최적화)
ExecStart=/usr/bin/java \
  -Xms256m \
  -Xmx512m \
  -XX:MetaspaceSize=128m \
  -XX:MaxMetaspaceSize=256m \
  -XX:+UseG1GC \
  -XX:+HeapDumpOnOutOfMemoryError \
  -XX:HeapDumpPath=/home/yasong-art-gallery/logs/heapdump.hprof \
  -jar /home/yasong-art-gallery/yasong-art-gallery.jar \
  --spring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod}

# 정상 종료 시그널
SuccessExitStatus=143
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 로그 설정 (journalctl로 관리)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yasong-art-gallery

# 자동 재시작 설정
Restart=always
RestartSec=10

# 보안 설정
NoNewPrivileges=true
PrivateTmp=true

# 리소스 제한
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
