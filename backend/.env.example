# 운영 백엔드 환경변수 예시입니다. 실제 비밀값은 커밋하지 않습니다.
# 최초 서버 설정 시 deployment/guides/production.md를 따라 서버 .env로 준비합니다.
# 기존 운영 .env를 덮어쓰지 않습니다. 로컬 개발은 application-local.properties를 사용합니다.
# systemd EnvironmentFile 형식: KEY=value (export를 붙이지 않습니다).

# 필수: Base64 JWT 키. 생성: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# 필수: 실제 DB 주소와 앱 전용 계정으로 변경합니다.
DB_URL=jdbc:mysql://localhost:3306/yasongmuseum?useSSL=true&serverTimezone=Asia/Seoul
DB_USERNAME=yasongmuseum
DB_PASSWORD=

# 기본 운영 구성: Nginx가 127.0.0.1:8080으로 연결합니다.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
FILE_UPLOAD_DIR=/home/yasong-art-gallery/uploads
JWT_EXPIRATION=86400000

# 선택: 관리자 Google Analytics 통계. JSON은 저장소 밖의 절대 경로로 지정합니다.
GA_PROPERTY_ID=
GA_CREDENTIALS_PATH=
